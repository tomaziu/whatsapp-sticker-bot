# WhatsApp Sticker Bot - Configuração de Pareamento
# Copie este arquivo para .env e preencha com seus dados

# Número de telefone para pareamento (DDI + DDD + número, SEM +)
# Exemplo Brasil: 5511999999999 (DDI 55, DDD 11, número 999999999)
PAIRING_PHONE=5511999999999

# Chave da API NVIDIA (opcional, para comando .ia)
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx